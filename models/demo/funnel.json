{
  "name": "demo-funnel",
  "description": "Score every molecule with the demo model, keep the best, re-score the survivors after approval.",
  "steps": [
    {
      "id": "screen",
      "model": "demo/score",
      "map": "$inputs.molecules",
      "inputs": {"target": "$inputs.target", "molecule": "$item"},
      "keep": {"top": 3, "by": "score", "min": {"qed": 0.1}}
    },
    {
      "id": "rescore",
      "model": "demo/score",
      "map": "$screen.items",
      "inputs": {"target": "$inputs.target", "molecule": "$item.inputs.molecule"},
      "approve": true,
      "retries": 1
    }
  ],
  "outputs": {"shortlist": "$rescore.items"}
}
